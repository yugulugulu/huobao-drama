# 复制为 .env.development 或 .env.production 后按环境填写。
PORT=5679
NODE_ENV=development
SERVE_FRONTEND=false

# MySQL 数据库。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=huobao
MYSQL_PASSWORD=请填写数据库密码
MYSQL_DATABASE=huobao_drama
MYSQL_CONNECTION_LIMIT=10

# JWT 有效期由代码固定为 1 天，密钥至少 32 位。
JWT_SECRET=请填写至少32位随机密钥
COOKIE_SECURE=false

# 旧版单用户数据的归属账号。
LEGACY_OWNER_EMAIL=legacy@local.huobao
LEGACY_OWNER_DISPLAY_NAME=历史数据所有者
LEGACY_OWNER_PASSWORD=请填写高强度密码

# 按环境选择 local 或 oss；当前开发和生产环境均使用 OSS，开发环境必须指向独立开发桶。
STORAGE_DRIVER=oss
STORAGE_PATH=../data/static
PUBLIC_BASE_URL=http://localhost:5679

# 仅 STORAGE_DRIVER=oss 时必填。
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=请填写OSS存储桶名称
OSS_ACCESS_KEY_ID=请填写AccessKeyId
OSS_ACCESS_KEY_SECRET=请填写AccessKeySecret
OSS_PUBLIC_BASE_URL=https://请填写OSS公开访问域名

# 可选：关闭中转文本模型的 thinking 输出。
AI_DISABLE_THINKING=true
# AI_THINKING_OFF_PATCH={"thinking":{"type":"disabled"},"enable_thinking":false}
